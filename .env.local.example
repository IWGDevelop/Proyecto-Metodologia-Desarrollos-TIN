# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — IGSI Gestión de Requerimientos
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copia este archivo como .env.local
# 2. Rellena los valores desde: https://supabase.com/dashboard → tu proyecto
#    → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# ── PÚBLICAS (llegan al browser — seguras con RLS activo) ────────────────────
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nombre de la app (UI only)
NEXT_PUBLIC_APP_NAME=IGSI - Gestión de Requerimientos

# ── PRIVADAS (solo server-side — NUNCA usar NEXT_PUBLIC_) ────────────────────
# Settings → API → Project API keys → service_role secret
# ⚠️  Tiene acceso total, bypassea RLS. Solo para Server Actions / Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
